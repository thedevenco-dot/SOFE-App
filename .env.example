# ===== Shared =====
NODE_ENV=development
APP_ENV=dev                      # dev | staging | prod
TZ=UTC

# ===== API (apps/api) =====
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# MongoDB Atlas (use a separate database user per environment; never reuse prod credentials)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sofe_dev?retryWrites=true&w=majority
MONGODB_DB_NAME=sofe_dev

# Firebase Admin (verify learner and admin ID tokens)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Field encryption for admin 2FA secrets (32 bytes, base64)
FIELD_ENCRYPTION_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_WEBHOOK_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RevenueCat
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="SOFE <hello@yourdomain.com>"

# Zoho Bigin
BIGIN_CLIENT_ID=
BIGIN_CLIENT_SECRET=
BIGIN_REFRESH_TOKEN=

# Push (Expo)
EXPO_ACCESS_TOKEN=

# Monitoring and analytics
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ===== Mobile (apps/mobile) - only EXPO_PUBLIC_ values are bundled; never put secrets here =====
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_SENTRY_DSN=

# ===== Admin (apps/admin) =====
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_SENTRY_DSN=

